# Copy to .env and fill in. .env is git-ignored. Values here are non-secret defaults.
# Docker Compose also reads this file for ${...} interpolation in docker-compose*.yml.

# --- Docker network (compose interpolation only) ---------------------------------
# Name of the existing external ipvlan network on UnRAID (docker network ls).
DOCKER_NETWORK=br0
# Fixed LAN IP of the container; router DNS points the weather hosts here.
CONTAINER_IP=192.168.1.200

# --- Home Assistant backends ------------------------------------------------------
# Both are OFF by default. Enable at least one, otherwise the container exits with an error.
# Enabling both creates two HA devices with the same data (duplicate entities).
#
# ESPHome: the container acts as an ESPHome device (Native API, TCP 6053). In HA:
# Settings -> Devices & services -> Add integration -> ESPHome -> host = CONTAINER_IP.
# No MQTT broker needed.
ESPHOME_ENABLED=false
ESPHOME_PORT=6053
# Device name (hostname-like: a-z, 0-9, '-'; max 31 chars). Changing it later breaks the HA entry.
ESPHOME_NAME=weather-station
# Fixed MAC reported to HA (it is the device's unique id). Empty = derived from DEVICE_ID.
ESPHOME_MAC=
# Optional API encryption (same as ESPHome `api: encryption: key:`). Empty = plaintext.
# Generate with: openssl rand -base64 32   -- secret: keep it only in .env.
ESPHOME_ENCRYPTION_KEY=
# Advertise _esphomelib._tcp via mDNS so HA discovers the device automatically.
ESPHOME_MDNS=true
#
# MQTT: Home Assistant MQTT discovery through a broker (e.g. Mosquitto add-on).
MQTT_ENABLED=false

# --- MQTT broker (used only when MQTT_ENABLED=true) ----------------------------------
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=weatherbridge
# Password of the HA user above. Secret: only in .env, never in compose / git.
MQTT_PASSWORD=

# --- Forwarding to the real services ---------------------------------------------
# Initial state of forwarding. After a toggle from Home Assistant the state saved in
# data/state.json takes precedence on restart (delete it to fall back to these).
FORWARD_WU=true
FORWARD_WC=true
# DNS servers used ONLY for resolving upstream hosts. Must not be the router:
# it resolves the weather hosts to this container (loop).
UPSTREAM_DNS=1.1.1.1,9.9.9.9
# Upstream request timeout in seconds; on timeout the console gets the recorded response.
UPSTREAM_TIMEOUT=8
# Optional: override station ID / key sent to Weather Underground.
# Empty = forward the console's own ID/PASSWORD unchanged.
WU_USERNAME=
WU_PASSWORD=

# --- Home Assistant device (both backends) --------------------------------------
# DEVICE_NAME is the HA device name; entity ids become sensor.<slug of DEVICE_NAME>_temperature.
# DEVICE_ID is the MQTT unique-id/default entity prefix and the seed of the default ESPHome MAC.
DEVICE_ID=weather_station
DEVICE_NAME=Weather Station
DEVICE_MANUFACTURER=VEVOR
DEVICE_MODEL=VEVOR YT60234
# MQTT discovery prefix configured in HA (default homeassistant).
DISCOVERY_PREFIX=homeassistant
# Base topic for state (<BASE_TOPIC>/state), availability (<BASE_TOPIC>/status)
# and switch commands (<BASE_TOPIC>/forward/<wu|wc>/set).
BASE_TOPIC=meteo_proxy
# metric (°C, km/h, mm, hPa) or imperial (°F, mph, in, inHg, values passed through).
UNITS=metric

# --- Misc ---------------------------------------------------------------------------
TZ=Europe/Berlin
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
