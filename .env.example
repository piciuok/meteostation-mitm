# Copy to .env and fill in. .env is git-ignored. Values here are non-secret defaults.
# Docker Compose also reads this file for ${...} interpolation in docker-compose*.yml.

# --- Docker network (compose interpolation only) ---------------------------------
# Name of the existing external ipvlan network on UnRAID (docker network ls).
DOCKER_NETWORK=br0
# Fixed LAN IP of the container; router DNS points the weather hosts here.
CONTAINER_IP=192.168.10.200

# --- MQTT broker (Mosquitto add-on in Home Assistant) ----------------------------
# Leave MQTT_HOST empty to run without Home Assistant (proxy/mock only).
MQTT_HOST=192.168.10.11
MQTT_PORT=1883
MQTT_USER=meteo_proxy
# Password of the HA user above. Secret: only in .env, never in compose / git.
MQTT_PASSWORD=

# --- Forwarding to the real services ---------------------------------------------
# Initial state of forwarding. After a toggle from Home Assistant the state saved in
# data/state.json takes precedence on restart (delete it to fall back to these).
FORWARD_WU=true
FORWARD_WC=true
# DNS servers used ONLY for resolving upstream hosts. Must not be the router:
# it resolves the weather hosts to this container (loop).
UPSTREAM_DNS=1.1.1.1,9.9.9.9
# Upstream request timeout in seconds; on timeout the console gets the recorded response.
UPSTREAM_TIMEOUT=8
# Optional: override station ID / key sent to Weather Underground.
# Empty = forward the console's own ID/PASSWORD unchanged.
WU_USERNAME=
WU_PASSWORD=

# --- Home Assistant device ----------------------------------------------------------
# DEVICE_ID is the entity_id prefix: sensor.<DEVICE_ID>_temperature etc.
DEVICE_ID=weather_station
DEVICE_NAME=Weather Station
DEVICE_MANUFACTURER=VEVOR
DEVICE_MODEL=VEVOR YT60234
# MQTT discovery prefix configured in HA (default homeassistant).
DISCOVERY_PREFIX=homeassistant
# Base topic for state (<BASE_TOPIC>/state), availability (<BASE_TOPIC>/status)
# and switch commands (<BASE_TOPIC>/forward/<wu|wc>/set).
BASE_TOPIC=meteo_proxy
# metric (°C, km/h, mm, hPa) or imperial (°F, mph, in, inHg, values passed through).
UNITS=metric

# --- Misc ---------------------------------------------------------------------------
TZ=Europe/Warsaw
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
